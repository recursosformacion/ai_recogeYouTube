# Optional. Create a key in Google Cloud and enable YouTube Data API v3.
# Never commit a real API key.
YOUTUBE_API_KEY=

# Local data location. Defaults to ./data/ai_recogeyoutube.sqlite3
AI_YOUTUBE_DB_PATH=./data/ai_recogeyoutube.sqlite3

# Default maximum results per query (YouTube API supports up to 50 per search request).
AI_YOUTUBE_MAX_RESULTS=25
